    "Usage: link [options] file [options]",
    "",
    "Options:",
    "    ( /option is also accepted )",
    "",
    "    /ALIGN:number              specify alignment of each section",
    "    /BASE:address              set program base address",
    "    /COMMENT:string            embed comment string into image",
    "    /DEBUG[:type]              link in debugging information",
    "    /DEF:filename              process .def file",
    "    /DEFAULTLIB:library        add one or more libraries to search",
    "    /DLL                       build DLL",
    "    /ENTRY:symbol              set starting address",
    "    /EXPORT:exportdef          export a symbol",
    "    /FORCE:MULTIPLE            allow multiply defined symbols",
    "    /FORCE:UNDEFINED           allow undefined symbols",
    "    /HEAP:reserve[,commit]     set heap size in bytes",
    "    /IMPLIB:filename           override default import library name",
    "    /INCLUDE:symbol            force reference to a symbol",
    "    /INCREMENTAL:yes|no        enable or disable incremental linking",
    "    /MAP[:filename]            generate map file",
    "    /NODEFAULTLIB              ignore default libraries",
    "    /NOFUZZY                   disable fuzzy linking",
    "    /NOINVOKE                  don't invoke the Watcom tool",
    "    /NOLOGO                    don't display copyright banner",
    "    /NOWOPTS                   disable default options",
    "    /NOWREF                    disable default startup module references",
    "    /NOWWARN                   disable warning messages for ignored options",
    "    /OPT:REF                   enable dead code elimination",
    "    /OPT:NOREF                 disable dead code elimination",
    "    /OUT:filename              specify output file name",
    "    /PASSWOPTS:options         pass options directly to the Watcom tools",
    "    /RELEASE                   set the checksum in the executable header",
    "    /SHOWWOPTS                 show translated options",
    "    /STACK:reserve[,commit]    set stack size in bytes",
    "    /STUB:filename             attach DOS stub to program",
    "    /SUBSYSTEM:subsystem       tell OS how to run the executable",
    "    /VERSION:major[.minor]     embed version number into output file",
