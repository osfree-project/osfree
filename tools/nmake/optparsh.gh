    int             K;
    int             L;
    int             N;
    int             noinvoke;
    int             NOLOGO;
    int             P;
    int             Q;
    int             R;
    int             S;
    int             T;
    int             U;
    int             Y;
    int             X;
    OPT_STRING *    X_value;
    int             nowwarn;
    int             nowopts;
    int             passwopts;
    OPT_STRING *    passwopts_value;
    int             showwopts;
    int             verbose;
} OPT_STORAGE;

#endif /* OPTPARSH_GH */
