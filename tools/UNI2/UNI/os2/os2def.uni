group os2def;
begin
  // Basic return codes
  type APIRET = uint32;
  type APIRET16 = uint16;
  type APIRET32 = uint32;

  // Boolean values
  type BOOL = uint32;      // f
  type BOOL16 = uint16;
  type PBOOL = ^BOOL;
  type PBOOL16 = ^BOOL16;

  // Handles
  type SHANDLE = uint16;
  type LHANDLE = uint32;

  // Null handle values
  constant NULLHANDLE = ((LHANDLE)0);
  constant NULLSHANDLE = ((SHANDLE)0);

  // Error identification
  type ERRORID = ULONG;    // errid
  type PERRORID = ^ERRORID;

  // Character and integer types
  type CHAR = int8;        // ch
  type SHORT = int16;      // s
  type LONG = int32;       // l
  type UCHAR = uint8;      // uch
  type USHORT = uint16;    // us
  type ULONG = uint32;     // ul
  type BYTE = int8;        // b
  type INT = int32;        // i
  type UINT = uint32;      // ui

  // Selector
  type SEL = USHORT;       // sel
  type PSEL = ^SEL;

  // Common DOS types
  type HMODULE = LHANDLE;  // hmod
  type PID = LHANDLE;      // pid
  type TID = LHANDLE;      // tid
  type HFILE = LHANDLE;    // hf
  type SGID = USHORT;      // sgid

  type PHMODULE = ^HMODULE;
  type PPID = ^PID;
  type PTID = ^TID;
  type PHFILE = ^HFILE;

  // Semaphore handle
  type HSEM = ^VOID;       // hsem (pointer to void)
  type PHSEM = ^HSEM;

  // Common SUP types
  type HAB = LHANDLE;      // hab
  type PHAB = ^HAB;

  // Common GPI/DEV types
  type HPS = LHANDLE;      // hps
  type PHPS = ^HPS;
  type HDC = LHANDLE;      // hdc
  type PHDC = ^HDC;
  type HRGN = LHANDLE;     // hrgn
  type PHRGN = ^HRGN;
  type HBITMAP = LHANDLE;  // hbm
  type PHBITMAP = ^HBITMAP;
  type HMF = LHANDLE;      // hmf
  type PHMF = ^HMF;
  type HPAL = LHANDLE;     // hpal
  type PHPAL = ^HPAL;

  // Color
  type COLOR = LONG;       // clr
  type PCOLOR = ^COLOR;

  // Fixed point
  type FIXED = LONG;       // fx
  type PFIXED = ^FIXED;

  // Procedure types
  type _PFN = function(): int32;
  type PFN = ^_PFN;
  type _NPFN = function(): int32;
  type NPFN = ^_NPFN;

  // Pointer types
  type PSZ = ^CHAR;
  type NPSZ = ^CHAR;
  type PCH = ^CHAR;
  type NPCH = ^CHAR;
  type PCSZ = ^CHAR;      // const char * not supported
  type PBYTE = ^BYTE;
  type NPBYTE = ^BYTE;
  type PCHAR = ^CHAR;
  type PSHORT = ^SHORT;
  type PLONG = ^LONG;
  type PINT = ^INT;
  type PUCHAR = ^UCHAR;
  type PUSHORT = ^USHORT;
  type PULONG = ^ULONG;
  type PUINT = ^UINT;

  // Void pointer
  type PVOID = pointer;
  type PPVOID = ^PVOID;

  // Structures

  // Quad-word
  structure QWORD;
    ulLo: ULONG;
    ulHi: ULONG;
  end;
  type PQWORD = ^QWORD;

  // Point in long integers
  structure POINTL;
    x: LONG;
    y: LONG;
  end;
  type PPOINTL = ^POINTL;
  type NPPOINTL = ^POINTL;

  // Point in short integers
  structure POINTS;
    x: SHORT;
    y: SHORT;
  end;
  type PPOINTS = ^POINTS;

  // Rectangle in long integers
  structure RECTL;
    xLeft: LONG;
    yBottom: LONG;
    xRight: LONG;
    yTop: LONG;
  end;
  type PRECTL = ^RECTL;
  type NPRECTL = ^RECTL;

  // Matrix of fixed-point values
  structure MATRIXLF;
    fxM11: FIXED;
    fxM12: FIXED;
    lM13: LONG;
    fxM21: FIXED;
    fxM22: FIXED;
    lM23: LONG;
    lM31: LONG;
    lM32: LONG;
    lM33: LONG;
  end;
  type PMATRIXLF = ^MATRIXLF;

  // Character array used in font names
  type STR8 = array[0..7] of CHAR;  // str8
  type PSTR8 = ^STR8;

  // Device driver data
  structure DRIVDATA;
    cb: LONG;
    lVersion: LONG;
    szDeviceName: array[0..31] of CHAR;
    abGeneralData: array[0..0] of CHAR;
  end;
  type PDRIVDATA = ^DRIVDATA;

  // Pointer to array of PSZ
  type PDEVOPENDATA = ^PSZ;

  // Array indices for DEVOPENSTRUC
  constant ADDRESS = 0;
  constant DRIVER_NAME = 1;
  constant DRIVER_DATA = 2;
  constant DATA_TYPE = 3;
  constant COMMENT = 4;
  constant PROC_NAME = 5;
  constant PROC_PARAMS = 6;
  constant SPL_PARAMS = 7;
  constant NETWORK_PARAMS = 8;

  // Structure for DevOpenDC parameters
  structure DEVOPENSTRUC;
    pszLogAddress: PSZ;
    pszDriverName: PSZ;
    pdriv: PDRIVDATA;
    pszDataType: PSZ;
    pszComment: PSZ;
    pszQueueProcName: PSZ;
    pszQueueProcParams: PSZ;
    pszSpoolerParams: PSZ;
    pszNetworkParams: PSZ;
  end;
  type PDEVOPENSTRUC = ^DEVOPENSTRUC;

  // Print destination information
  structure PRINTDEST;
    cb: ULONG;
    lType: LONG;
    pszToken: PSZ;
    lCount: LONG;
    pdopData: PDEVOPENDATA;
    fl: ULONG;
    pszPrinter: PSZ;
  end;
  type PPRINTDEST = ^PRINTDEST;

  constant PD_JOB_PROPERTY = 0x0001;

  // Font attributes selections
  constant FATTR_SEL_ITALIC = 0x0001;
  constant FATTR_SEL_UNDERSCORE = 0x0002;
  constant FATTR_SEL_OUTLINE = 0x0008;
  constant FATTR_SEL_STRIKEOUT = 0x0010;
  constant FATTR_SEL_BOLD = 0x0020;
  constant FATTR_SEL_MUST_COLOR = 0x0100;
  constant FATTR_SEL_MUST_MIXEDMODES = 0x0200;
  constant FATTR_SEL_MUST_HOLLOW = 0x0400;

  // Font attributes types
  constant FATTR_TYPE_KERNING = 0x0004;
  constant FATTR_TYPE_MBCS = 0x0008;
  constant FATTR_TYPE_DBCS = 0x0010;
  constant FATTR_TYPE_ANTIALIASED = 0x0020;

  // Font use flags
  constant FATTR_FONTUSE_NOMIX = 0x0002;
  constant FATTR_FONTUSE_OUTLINE = 0x0004;
  constant FATTR_FONTUSE_TRANSFORMABLE = 0x0008;

  constant FACESIZE = 32;

  // Font attributes structure
  structure FATTRS;
    usRecordLength: USHORT;
    fsSelection: USHORT;
    lMatch: LONG;
    szFacename: array[0..31] of CHAR;
    idRegistry: USHORT;
    usCodePage: USHORT;
    lMaxBaselineExt: LONG;
    lAveCharWidth: LONG;
    fsType: USHORT;
    fsFontUse: USHORT;
  end;
  type PFATTRS = ^FATTRS;

  // Font metrics type flags
  constant FM_TYPE_FIXED = 0x0001;
  constant FM_TYPE_LICENSED = 0x0002;
  constant FM_TYPE_KERNING = 0x0004;
  constant FM_TYPE_DBCS = 0x0010;
  constant FM_TYPE_MBCS = 0x0018;
  constant FM_TYPE_UNICODE = 0x0040;
  constant FM_TYPE_64K = 0x8000;
  constant FM_TYPE_ATOMS = 0x4000;
  constant FM_TYPE_FAMTRUNC = 0x2000;
  constant FM_TYPE_FACETRUNC = 0x1000;

  // Font metrics definition flags
  constant FM_DEFN_OUTLINE = 0x0001;
  constant FM_DEFN_IFI = 0x0002;
  constant FM_DEFN_WIN = 0x0004;
  constant FM_DEFN_GENERIC = 0x8000;

  // Character set bits
  constant FM_DEFN_LATIN1 = 0x0010;
  constant FM_DEFN_PC = 0x0020;
  constant FM_DEFN_LATIN2 = 0x0040;
  constant FM_DEFN_CYRILLIC = 0x0080;
  constant FM_DEFN_HEBREW = 0x0100;
  constant FM_DEFN_GREEK = 0x0200;
  constant FM_DEFN_ARABIC = 0x0400;
  constant FM_DEFN_UGLEXT = 0x0800;
  constant FM_DEFN_KANA = 0x1000;
  constant FM_DEFN_THAI = 0x2000;

  constant FM_DEFN_UGL383 = 0x0070;
  constant FM_DEFN_UGL504 = 0x00F0;
  constant FM_DEFN_UGL767 = 0x0FF0;
  constant FM_DEFN_UGL1105 = 0x3FF0;

  // Font selection flags
  constant FM_SEL_ITALIC = 0x0001;
  constant FM_SEL_UNDERSCORE = 0x0002;
  constant FM_SEL_NEGATIVE = 0x0004;
  constant FM_SEL_OUTLINE = 0x0008;
  constant FM_SEL_STRIKEOUT = 0x0010;
  constant FM_SEL_BOLD = 0x0020;
  constant FM_SEL_ISO9241_TESTED = 0x0040;

  // DBCS font encoding
  constant FM_SEL_JAPAN = 0x1000;
  constant FM_SEL_TAIWAN = 0x2000;
  constant FM_SEL_CHINA = 0x4000;
  constant FM_SEL_KOREA = 0x8000;
  constant FM_SEL_DBCSMASK = 0xF000;

  // Font capability flags
  constant FM_CAP_NOMIX = 0x0001;
  constant FM_CAP_NO_COLOR = 0x0002;
  constant FM_CAP_NO_MIXEDMODES = 0x0004;
  constant FM_CAP_NO_HOLLOW = 0x0008;

  // ISO test flags
  constant FM_ISO_9518_640 = 0x01;
  constant FM_ISO_9515_640 = 0x02;
  constant FM_ISO_9515_1024 = 0x04;
  constant FM_ISO_9517_640 = 0x08;
  constant FM_ISO_9517_1024 = 0x10;

  // PANOSE font classification
  structure PANOSE;
    bFamilyType: BYTE;
    bSerifStyle: BYTE;
    bWeight: BYTE;
    bProportion: BYTE;
    bContrast: BYTE;
    bStrokeVariation: BYTE;
    bArmStyle: BYTE;
    bLetterform: BYTE;
    bMidline: BYTE;
    bXHeight: BYTE;
    fbPassedISO: BYTE;
    fbFailedISO: BYTE;
  end;

  // Font metrics structure
  structure FONTMETRICS;
    szFamilyname: array[0..31] of CHAR;
    szFacename: array[0..31] of CHAR;
    idRegistry: USHORT;
    usCodePage: USHORT;
    lEmHeight: LONG;
    lXHeight: LONG;
    lMaxAscender: LONG;
    lMaxDescender: LONG;
    lLowerCaseAscent: LONG;
    lLowerCaseDescent: LONG;
    lInternalLeading: LONG;
    lExternalLeading: LONG;
    lAveCharWidth: LONG;
    lMaxCharInc: LONG;
    lEmInc: LONG;
    lMaxBaselineExt: LONG;
    sCharSlope: SHORT;
    sInlineDir: SHORT;
    sCharRot: SHORT;
    usWeightClass: USHORT;
    usWidthClass: USHORT;
    sXDeviceRes: SHORT;
    sYDeviceRes: SHORT;
    sFirstChar: SHORT;
    sLastChar: SHORT;
    sDefaultChar: SHORT;
    sBreakChar: SHORT;
    sNominalPointSize: SHORT;
    sMinimumPointSize: SHORT;
    sMaximumPointSize: SHORT;
    fsType: USHORT;
    fsDefn: USHORT;
    fsSelection: USHORT;
    fsCapabilities: USHORT;
    lSubscriptXSize: LONG;
    lSubscriptYSize: LONG;
    lSubscriptXOffset: LONG;
    lSubscriptYOffset: LONG;
    lSuperscriptXSize: LONG;
    lSuperscriptYSize: LONG;
    lSuperscriptXOffset: LONG;
    lSuperscriptYOffset: LONG;
    lUnderscoreSize: LONG;
    lUnderscorePosition: LONG;
    lStrikeoutSize: LONG;
    lStrikeoutPosition: LONG;
    sKerningPairs: SHORT;
    sFamilyClass: SHORT;
    lMatch: LONG;
    FamilyNameAtom: LONG;
    FaceNameAtom: LONG;
    panose: PANOSE;
  end;
  type PFONTMETRICS = ^FONTMETRICS;

  // Common WIN types
  type MPARAM = pointer;   // mp
  type PMPARAM = ^MPARAM;
  type MRESULT = pointer;  // mres
  type PMRESULT = ^MRESULT;
  type HWND = LHANDLE;     // hwnd
  type PHWND = ^HWND;
  type HMQ = LHANDLE;      // hmq
  type PHMQ = ^HMQ;
  type HPOINTER = LHANDLE;

  // Macro aliases for common structures
  constant WRECT = RECTL;
  constant PWRECT = PRECTL;
  constant NPWRECT = NPRECTL;
  constant WPOINT = POINTL;
  constant PWPOINT = PPOINTL;
  constant NPWPOINT = NPPOINTL;

  // Icon information
  structure ICONINFO;
    cb: ULONG;             // size of ICONINFO structure
    fFormat: ULONG;
    pszFileName: PSZ;      // use when fFormat = ICON_FILE
    hmod: HMODULE;         // use when fFormat = ICON_RESOURCE
    resid: ULONG;          // use when fFormat = ICON_RESOURCE
    cbIconData: ULONG;     // use when fFormat = ICON_DATA
    pIconData: PVOID;      // use when fFormat = ICON_DATA
  end;
  type PICONINFO = ^ICONINFO;

  // Icon format flags
  constant ICON_FILE = 1;
  constant ICON_RESOURCE = 2;
  constant ICON_DATA = 3;
  constant ICON_CLEAR = 4;

  // Accelerator table entry
  structure ACCEL;
    fs: USHORT;
    key: USHORT;
    cmd: USHORT;
  end;
  type PACCEL = ^ACCEL;

  // Large file support structures
  structure LONGLONG;
    ulLo: ULONG;
    ulHi: LONG;
  end;
  type PLONGLONG = ^LONGLONG;

  structure ULONGLONG;
    ulLo: ULONG;
    ulHi: ULONG;
  end;
  type PULONGLONG = ^ULONGLONG;
end;
