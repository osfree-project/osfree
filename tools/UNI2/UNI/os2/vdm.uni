group vdm;
begin
  constant DOS_OPEN  = $3D;
  constant DOS_CLOSE = $3E;
  constant DOS_READ  = $3F;
  constant DOS_WRITE = $40;

  (* DOS INT 21h *)
  function VdmOpen(in pszName: PSZ; in uchMode: UCHAR; out phFile: WORD): APIRET;
  function VdmClose(in hFile: WORD): APIRET;
  function VdmRead(in hFile: WORD; out pBuffer: VOID; in cbRead: WORD; out pcbActual: WORD): APIRET;
  function VdmWrite(in hFile: WORD; in pBuffer: PVOID; in cbWrite: WORD; out pcbActual: WORD): APIRET;
end;
