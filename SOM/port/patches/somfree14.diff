+SOMEXTERN int SOMLINK somtargFlagSL(int *argc, CORBA_char ***argv)
+{
+	int result;
+	CORBA_char *oldpos;
+	CORBA_char c; 
+  
+	SOMCFunctionStart("argc=%d", *argc);
+	
+	if ( !last_argc || *argc != last_argc )
+		argfound = 0;
+	
+	if ( !*argc )
+	{
+		SOMCFunctionEnd("result=%c", 0);
+		return 0;
+	}
+
+	argfound = argfound || ***argv == '-';
+	if ( !argfound )
+	{
+		SOMCFunctionEnd("result=%c", 0);
+		return 0;
+	}
+
+	if ( ***argv == '-' )
+	{
+		oldpos = somtdbcsPreincrSL(*argv);    
+		if (*oldpos)
+		{
+			if ( !*somtdbcsPreincrSL(*argv) )
+			{
+				ARG_STRING;
+				argfound = 0;
+			}
+			last_argc = *argc;
+			result = *oldpos;
+		}
+		else
+		{
+			ARG_STRING;
+			result = 0;
+		}
+	}
+	else
+	{
+		c = *somtdbcsPostincrSL(*argv);
+		if ( !***argv )
+		{
+			ARG_STRING;
+			argfound = 0;
+		}
+		last_argc = *argc;
+		result = c;
+	}
+
+	SOMCFunctionEnd("result=%c", result);
+	return result;
+}
