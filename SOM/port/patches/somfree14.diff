+SOMEXTERN CORBA_char * SOMLINK somtdbcsStrstrSL(CORBA_char *s1, CORBA_char *s2)
+{
+  SOMCDebug("%s not implemented", __FUNCTION__);
+  return NULL;
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtnextwordSL(const CORBA_char *s, CORBA_char *buf)
+{
+	CORBA_char *q;
+	CORBA_char *s2;
+
+	SOMCDebug("%s s='%s'", __FUNCTION__, s);
+
+	*buf=0;
+	if (!s) return NULL;
+	if (!s[0]) return NULL;
+
+    q=buf;
+	s2=(CORBA_char *)s;
+
+    while ((*s2)&&(*s2!=SMDELIMITER))
+	{
+      *q=*s2;
+      s2++;
+      q++;
+	}
+    *q=0;
+    if (*s2) s2++;
+	if (!s2[0]) return NULL;
+
+	return s2;
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtskipwsSL(const CORBA_char *s)
+{
+  SOMCDebug("%s not implemented", __FUNCTION__);
+  return NULL;
+}
+
+SOMEXTERN int SOMLINK somtdbcsLastCharSL(CORBA_char *buf)
+{
+  char *v2;
+  SOMCDebug("%s buf=\"%s\"", __FUNCTION__, buf);
+
+  v2 = 0;
+  while ( *buf )
+  {
+    v2 = buf;
+    buf += 2 - (somtisDbcsSL(*buf) == 0);
+  }
+  if ( !v2 )
+    return 0;
+  if ( somtisDbcsSL(*v2) )
+    return (*v2 << 8) + v2[1];
+  return *v2;
+  
+}
+
+SOMEXTERN int SOMLINK somtdbcsScanSL(CORBA_char **buf)
+{
+  CORBA_char *v3;
+
+//  SOMCDebug("buf=%s", **buf);
+
+  if (somtisDbcsSL(**buf))
+  {
+    v3 = *buf;
+    *buf += 2;
+    return v3[1] + (*v3 << 8);
+  }
+  else
+  {
+    v3 = (*buf)++;
+    //SOMCDebug("result=%c", *v3);
+    return *v3;
+  }
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtuppercaseSL(CORBA_char *s, CORBA_char *buf)
+{
+  SOMCDebug(__FUNCTION__);
+  while (*s) {
+    *buf=toupper(*s);
+    s++;
+    buf++;
+  }
+  *buf=0;
+  return buf;
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtlowercaseSL(CORBA_char *s, CORBA_char *buf)
+{
+  SOMCDebug("%s not implemented", __FUNCTION__);
+  while (*s) {
+    *buf=tolower(*s);
+    s++;
+    buf++;
+  }
+  *buf=0;
+  return buf;
+}
