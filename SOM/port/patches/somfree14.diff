+SOMEXTERN size_t SOMLINK somtsizeofEntrySL(SOMTTypes type)
+{
+  size_t sz=somtSOM30ABI?sizeof(Entry3)-sizeof(EntryUnion3):sizeof(Entry)-sizeof(EntryUnion); // 0x24 for som 3.0, 0x21 for som 2.1. default size of Entry structure without union
+
+  SOMCDebug("%s type=%d (%s)", __FUNCTION__, type, somttypeSL(type));
+
+  switch(type)
+  {
+	case SOMTAnyBE:
+    case SOMTBooleanBE:
+    case SOMTCaseEntryE:
+    case SOMTCaseListE:
+    case SOMTCaseSTME:
+    case SOMTCharBE:
+    case SOMTCopyrightE:
+    case SOMTDclListE:
+    case SOMTDefaultE:
+    case SOMTDoubleBE:
+    case SOMTFloatBE:
+    case SOMTGroupE:
+    case SOMTLongBE:
+    case SOMTNegativeBE:
+    case SOMTOctetBE:
+    case SOMTShortBE:
+    case SOMTTypeCodeBE:
+    case SOMTUnsignedLongBE:
+    case SOMTUnsignedShortBE:
+    case SOMTVoidBE:
+		break;
+    case SOMTClassE:
+		sz+=somtSOM30ABI?sizeof(Class3):sizeof(Class);
+		break;
+    case SOMTMetaE:
+		sz+=sizeof(Meta);
+		break;
+    case SOMTBaseE:
+		sz+=sizeof(Parent);
+		break;
+    case SOMTPassthruE:
+		sz+=sizeof(Passthru);
+		break;
+    case SOMTNewMethodE:
+    case SOMTOverrideMethodE:
+    case SOMTOverriddenMethodE:
+    case SOMTDataE:
+    case SOMTBadEntryE:
+    case SOMTArgumentE:
+    case SOMTTyDclE:
+    case SOMTTypedefBE:
+    case SOMTVoidPtrBE:
+		sz+=somtSOM30ABI?sizeof(Method_OR_Data3):sizeof(Method_OR_Data);
+		break;
+    case SOMTStructE:
+    case SOMTStructPE:
+    case SOMTStructSE:
+		sz+=somtSOM30ABI?sizeof(Struct3):sizeof(Struct);
+		break;
+    case SOMTTypedefE:
+		sz+=sizeof(Typedef);
+		break;
+    case SOMTUnionE:
+    case SOMTUnionSE:
+    case SOMTUnionPE:
+		sz+=somtSOM30ABI?sizeof(Union3):sizeof(Union);
+		break;
+    case SOMTEnumE:
+    case SOMTEnumPE:
+		sz+=sizeof(Enumerator);
+		break;
+    case SOMTConstE:
+		sz+=sizeof(Const);
+		break;
+    case SOMTAttE:
+		sz+=sizeof(Att);
+		break;
+    case SOMTSequenceE:
+    case SOMTSequenceTDE:
+		sz+=sizeof(Sequence);
+		break;
+    case SOMTStringBE:
+    case SOMTStringE:
+		sz+=sizeof(String);
+		break;
+    case SOMTEnumBE:
+		sz+=somtSOM30ABI?sizeof(EnumName3):sizeof(EnumName);
+		break;
+    case SOMTModuleE:
+		sz+=sizeof(Module);
+		break;
+    default:
+		somtwarnSL(somtfilePath, 0, "somtsizeofEntry(%s) = %d\n", somttypeSL(type), sz);
+		break;
+  }
+
+  SOMCDebug("size=%d", sz);
+
+  return sz;
+}
