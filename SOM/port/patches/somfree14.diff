+SOMEXTERN CORBA_char * SOMLINK somtsatosSL(CORBA_char **sa, CORBA_char *sep, CORBA_char *buf)
+{
+  int i;
+  CORBA_char *dst;
+
+  SOMCDebug("%s sa=0x%08X sep=\"%s\"", __FUNCTION__, sa, sep);
+
+  i = 0;
+  dst = buf;
+  if ( sa && *sa )
+  {
+    if (!strcmp(sep, "::"))
+    {
+      strcpy(buf, "::");
+      dst = buf + 2;
+    }
+    *dst = 0;
+    do
+    {
+      strcat(dst, sa[i]);
+      dst += strlen(dst);
+      if ( !dst )
+        break;
+      if ( !sa[++i] )
+        break;
+      if ( !strcat(dst, sep) )
+        break;
+      dst += strlen(sep);;
+    }
+    while ( dst );
+  }
+  *dst = 0;
+  SOMCDebug("%s saresult=\"%s\"", __FUNCTION__, buf);
+  return buf;
+}
