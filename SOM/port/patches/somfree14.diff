+CORBA_char * SOMLINK findattSL(AttList * Attrs, CORBA_char *name, CORBA_char **buf)
+{
+  CORBA_char *result;
+  CORBA_boolean notname;
+
+  SOMCFunctionStart("Attrs=0x%08X name=(0x%08X)\"%s\" buf=0x%08X", Attrs, name, name, buf);
+  dumpAttrs(dbg_level+11, __FUNCTION__, Attrs);
+
+  notname = FALSE;
+  if ( *name == '!' )
+  {
+    notname = TRUE;
+    ++name;
+  }
+  while ( TRUE )
+  {
+    if ( !Attrs )
+    {
+      if ( notname )
+        result = (CORBA_char *)TRUE;
+      else
+        result = NULL;
+	
+		SOMCFunctionEnd("result=(0x%08X)\"%s\"", result, result);
+		return result;
+    }
+
+    if ( Attrs->name && !strcmp(Attrs->name, name) )
+      break;
+  
+    Attrs = Attrs->next;
+  }
+
+	if ( notname )
+	{
+		SOMCFunctionEnd("result=(0x%08X)\"%s\"", NULL, NULL);
+		return NULL;
+	}
+
+	if ( !Attrs->value )
+	{
+		SOMCFunctionEnd("result=(0x%08X)\"%s\"", (CORBA_char *)TRUE, (CORBA_char *)TRUE);
+		return (CORBA_char *)TRUE;
+	}
+
+	if ( buf )
+		*buf = Attrs->value;
+
+	SOMCFunctionEnd("result=(0x%08X)\"%s\"", Attrs->value, Attrs->value);
+	return Attrs->value;
+}
