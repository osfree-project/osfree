+SOMEXTERN CORBA_char * SOMLINK somtdbcsStrrchrSL(CORBA_char *s, int c)
+{
+  SOMCDebug("%s s=%s c=%c", __FUNCTION__, s, c);
+  return strrchr(s, c);
+}
