+SOMEXTERN EmitFn  SOMLINK somtloadSL(CORBA_char *fileName, CORBA_char *functionName, void **modHandle)
+{
+  EmitFn proc=NULL;
+  HMODULE hmod=(HMODULE)NULL;
+
+  SOMCDebug(__FUNCTION__);
+
+  #ifdef _WIN32
+  hmod=LoadLibraryA(fileName);
+  if (hmod) proc=(EmitFn)GetProcAddress(hmod, functionName);
+  #endif
+
+  #ifdef _OS2_
+  APIRET rc = 0;
+  UCHAR szErrorName[CCHMAXPATH];   /* CCHMAXPATH defined in bsedos.h */
+
+  /* Load module.           */
+  rc=DosLoadModule(szErrorName, CCHMAXPATH-1, fileName, &hmod);
+  if (!rc) rc = DosQueryProcAddr(hmod, 0, functionName, (PFN *) proc);
+  if (rc) {hmod=NULL; proc=NULL;}
+  #endif
+
+  if (modHandle) *modHandle=(void *)hmod;
+
+  if ((void *)proc) 
+  {
+    if (!strcmp(fileName, "emitSL")) somtSOM30ABI=1;
+    if (!strcmp(fileName, "emit")) somtSOM30ABI=0;
+  };
+
+  return proc;
+}
+
+#ifndef SOM_SOMC_NO_BACKCOMPAT
+
+// Use IBM SOM 3.0 ABI for non SOMLINK functions (1) or IBM SOM 2.1 ABI (0)
+//SOMEXTERN int somtSOM30ABI;
+
+SOMEXTERN EmitFn OPTLINK somtload(CORBA_char *fileName, CORBA_char *functionName, void **modHandle)
+{
+  OPTLINK_ARGS(fileName, functionName, modHandle);
+
+  SOMCDebug(__FUNCTION__);
+  return somtloadSL(fileName, functionName, modHandle);
+}
+
+SOMEXTERN CORBA_char * OPTLINK somttype(SOMTTypes stype)
+{
+  SOMCDebug(__FUNCTION__);
+  exit(0);
+  if (somtSOM30ABI)
+  {
+    OPTLINK_1ARG_BYTE(stype);
+  }
+
+
+  return NULL;//somttypeSL(stype);
+}
+
+SOMEXTERN AttList * OPTLINK somtattalloc(MemBuf *membuf, CORBA_char *name, CORBA_char *value)
+{
+	AttList * result;
+	OPTLINK_ARGS(membuf, name, value);
+	SOMCFunctionStart("");
+	result=somtattallocSL(membuf, name, value);
+	SOMCFunctionEnd("result=0x%08X", result);
+	return result;
+}
+
+SOMEXTERN int OPTLINK somtargFlag(int *argc, CORBA_char ***argv)
+{
+	int result;
+	OPTLINK_ARGS(argc, argv);
+	SOMCFunctionStart("argc=%d", *argc);
+	result=somtargFlagSL(argc, argv);
+	SOMCFunctionEnd("result=%c", result);
+	return result;
+}
