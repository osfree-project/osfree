--- somfree\spp\src\_spp.l	Thu Jan 01 07:00:00 1970
+++ somfree_new\spp\src\_spp.l	Fri Jun 13 15:42:22 2025
@@ -0,0 +1,265 @@
+/**************************************************************************
+ *
+ *  Copyright 2022, Yuri Prokushev
+ *
+ *  This file is part of osFree project
+ *
