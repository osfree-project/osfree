+ *  ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ *  FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ *  more details.
+ *
+ *  You should have received a copy of the GNU Lesser General Public License
+ *  along with this program.  If not, see <http://www.gnu.org/licenses/>
+ *
+ */
+
+/*
+
+  SOM Preprocessor SPP is a original SOM Preprocessor of OIDL files.
+  Tested on all csc/sc files found by me. Not sure it will work as
+  drop-in replacement of original SPP.
+
+  @todo Add passthru section skip
+*/
+
+/* the "incl" state is used for picking up the name
+ * of an include file
+ */
+%x incl
+/* the "passthru" state is used for picking up the content
+ * of an passtru section
+ */
+%x passthru
+
+%{
+#include <stdlib.h>
+#include <string.h>
+#include <direct.h>
+#include <io.h>
+
+#define YY_NEVER_INTERACTIVE 1
+
+#define MAX_INCLUDE_DEPTH 20
+struct {
+  YY_BUFFER_STATE state;
+  char * filename;
+  char * fullfilename;
+  int lineno;
+} include_stack[MAX_INCLUDE_DEPTH];
+int include_stack_ptr = 0;
+
+int somtfexists(char *file)
+{
+	return (_access(file, 4)==0);  // Try RO access
+}
+
+char * somtsearchFile(char *file, char *fullpath, char *env)
+{
+  char *path;
+
+  if (!file) return NULL;
+  if (!file[0]) return NULL;
+
+  if (somtfexists(file))
+  {
+    return strcpy(fullpath, file);
+  }
+  else
+  {
+    if (file[0]=='/') return NULL;
+#if defined(_WIN32) || defined(__OS2__) || defined(__DOS__)
+    if (file[0]=='\\') return NULL;
+    if (file[1]==':') return NULL;
+#endif
+
+    path=getenv(env);
+
+#if !defined(_WIN32) && !defined(__OS2__) && !defined(__DOS__)
+    if (!path) path="/bin:/usr/bin:";
+#endif
+
+    if (path)
+    {
+      while (*path)
+      {
+        char buf[1024];
+        char *q;
+
+        q=buf;
+
+        while ((*path)&&(*path !=':'))
+        {
+          *q=*path;
+          path++;
+          q++;
+        }
+        *q=0;
+        if (*path) path++;
+
+        if (!buf[0])
+        {
+          _getcwd(buf,sizeof(buf));
+        }
+
+        if (buf[0])
+        {
+          if (!strcmp(buf,"."))
+          {
+            _getcwd(buf,sizeof(buf));
+          }
+          snprintf(buf, sizeof(buf)-1, "%s%c", buf, '\\');
+          strncat(buf,file,sizeof(buf)-1);
+
+          if (somtfexists(buf))
+          {
+            return strcpy(fullpath,buf);
+          }
+        }
+      }
+    }
+    return NULL;
+  }
+}
+
+%}
+
+%%
+
+^#include	{ BEGIN(incl); } 
+^"include "	{ BEGIN(incl); }
+
+^"passthru" {BEGIN(passthru);}
+^"endpassthru" {BEGIN(INITIAL);}
+
+[a-z]+		{ ECHO; }
+[^a-z\n]*\n?	{ ECHO; include_stack[include_stack_ptr].lineno++; }
+
+<incl>[ \t]*	{ /* eat the whitespace */ }
+<incl>[^ \t\n]+	{ /* got the include file name */
+
+		int	stki;
+		int is_include=1;
+		
+		if (include_stack_ptr >= MAX_INCLUDE_DEPTH)
+		{
+			fprintf(stderr, "Includes nested too deeply");
+			exit( 1 );
+		}
+
+		include_stack[include_stack_ptr].state = YY_CURRENT_BUFFER;
+
+		include_stack_ptr++;
+
+		include_stack[include_stack_ptr].filename=strdup(yytext+1);
+		include_stack[include_stack_ptr].filename[strlen(include_stack[include_stack_ptr].filename)-1]=0x0;
+		include_stack[include_stack_ptr].fullfilename=strdup(yytext+1);
+		include_stack[include_stack_ptr].fullfilename[strlen(include_stack[include_stack_ptr].fullfilename)-1]=0x0;
+
+		for(stki=0;stki<include_stack_ptr;stki++)
+		{
+			//printf("%d %s\n",stki, include_stack[stki].fullfilename);
+			//printf("%d \"%s\"\n",include_stack_ptr,include_stack[include_stack_ptr].fullfilename);
+			if (!strcmp(include_stack[stki].fullfilename,include_stack[include_stack_ptr].fullfilename)) 
+			{
+//				printf("double %s\n", include_stack[stki].fullfilename);
+				include_stack_ptr--;
+				is_include=0;
+				break;
+			}
+		}
+
+		if (is_include)
+		{
+			if (yytext[0]=='<')
+			{
+				char fullpath[260];
+				somtsearchFile(include_stack[include_stack_ptr].filename, fullpath, "SMINCLUDE");
+				free(include_stack[include_stack_ptr].fullfilename);
+				include_stack[include_stack_ptr].fullfilename=strdup(fullpath);
+			}
+
+			yyin = fopen(include_stack[include_stack_ptr].fullfilename, "r");
+
+			if (!yyin)
+			{
+				fprintf(stderr, "fopen %s error", include_stack[include_stack_ptr].filename);
+				exit(1);
+			}
+
+			fprintf(yyout, "@ 1 \"%s\" \"%s\"\n", include_stack[include_stack_ptr].filename, include_stack[include_stack_ptr].fullfilename);
+			yy_switch_to_buffer(yy_create_buffer(yyin, YY_BUF_SIZE));
+
+		}
+
+		BEGIN(INITIAL);
+
+	   }
+
+<<EOF>> {
+	   if (	--include_stack_ptr < 0	)
+	       {
+	       yyterminate();
+	       }
+
+	   else
+	       {
+		yy_delete_buffer( YY_CURRENT_BUFFER );
+		yy_switch_to_buffer(include_stack[include_stack_ptr].state);
+		fprintf(yyout, "@ %d \"%s\" \"%s\"\n", include_stack[include_stack_ptr].lineno, include_stack[include_stack_ptr].filename, include_stack[include_stack_ptr].filename);
+	       }
+
+	   }
+
+%%
+
+
+int yywrap()
+{
+  return 1;
+}
+
+
+void showVersion()
+{
+  printf("SOM Preprocessor v1.0\n");
+}
+
+void showUsage()
+{
+    showVersion();
+	printf("spp [filename]\n");
+}
+
+int main(int argc, char *argv[])
+{
+  if (argc)
+  {
+    if (!strncmp(argv[1], "-V",3)) showVersion();
+  }
+  else
+  {
+    showUsage();
+    return 0;
+  }
+
+  if (somtfexists(argv[1]))
+  {
+    yyin=fopen(argv[1],"r");
+
+    include_stack[include_stack_ptr].filename=strdup(argv[1]);
+    include_stack[include_stack_ptr].fullfilename=strdup(argv[1]);
+    include_stack[include_stack_ptr].lineno=1;
+
+// Виснет. Видимо файл еще не открыт...
+//	fprintf(yyout, "@ %d \"%s\" \"%s\"\n", include_stack[include_stack_ptr].lineno, include_stack[include_stack_ptr].filename, include_stack[include_stack_ptr].filename);
+    yylex();
+  }
+
+  return 0;
+}
