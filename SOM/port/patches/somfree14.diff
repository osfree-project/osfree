+SOMEXTERN BOOL SOMLINK somtisDbcsSL(int c)
+{
+	BOOL result;
+	SOMCFunctionStart("c=%c", c);
+
+	result=(c > 0xff)?TRUE:IsDBCSLeadByte(c);
+	SOMCFunctionEnd("result=%d", result);
+	return result;
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtdbcsPostincrSL(CORBA_char **p)
+{
+	CORBA_char * result;
+
+	SOMCFunctionStart("p=0x%08X", p);
+
+	result = *p;
+
+	if ( somtisDbcsSL(**p) )
+		*p += 2;
+	else
+		++*p;
+
+	SOMCFunctionEnd("result=\"%s\"", result);
+	return result;
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtdbcsPreincrSL(CORBA_char **p)
+{
+	CORBA_char * result;
+	SOMCFunctionStart("p=0x%08X",p);
+	result=(somtisDbcsSL(**p))?(*p + 2):(++*p);
+	SOMCFunctionEnd("result=\"%s\"", result);
+	return result;
+}
+
+SOMEXTERN int SOMLINK somticstrcmpSL(CORBA_char *s, CORBA_char *t)
+{
+	SOMCDebug("%s s=\"%s\" t=\"%s\"",__FUNCTION__, s, t);
+	return _stricmp(s, t);
+}
+
+SOMEXTERN CORBA_char * SOMLINK somtdbcsStrchrSL(CORBA_char *s, int c)
+{
+  SOMCDebug("%s s=%s c=%c", __FUNCTION__, s, c);
+  return strchr(s, c);
+}
