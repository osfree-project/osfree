+#define global
+#include <emitlib.h>
+
+int dbg_level=0;
+
+void DumpEp(int level, Entry * ep);
+
+void lprintf(int level, char * fmt, ...)
+{
+	va_list va;
+
+	if (level)
+	{
+		unsigned long i;
+
+		i=level << 1;
+
+		while (i--)
+		{
+			printf(" ");
+		}
+	}
+
+	va_start(va,fmt);
+
+	vprintf(fmt,va);
+
+	va_end(va);
+}
+
+void dumpAttrs(int level, char * name, AttList *ap)
+{
+	AttList *cur = ap;
+
+	lprintf(level, "%s AttList at 0x%08X\n", name, ap);
+
+	for(cur = ap; cur; cur = cur->next) 
+	{
+		lprintf(level, "%s (0x%08X)\"%s\"=(0x%08X)\"%s\"\n", name, cur->name, cur->name, cur->value, cur->value);
+	}
+}
+
+void dumpMlist(int level, char * name, Mlist *ap)
+{
+  Mlist *cur;
+
+  for(cur = ap; cur; cur = cur->next) 
+  {
+	DumpEp(level, cur->ep);
+  }
+}
+
+void dumpReleaseOrder(int level, char * name, AttList *ap)
+{
+  AttList *cur;
+
+  for(cur=ap; cur; cur=cur->next) 
+  {
+    lprintf(level, "\t%s %s=%s\n", name, cur->name, cur->value);
+//    dumpAttrs("static", cur->staticlist);
+//    dumpAttrs("protectted", cur->protectedlist);
+//    dumpAttrs("public", cur->publiclist);
+//    dumpAttrs("private", cur->privatelist);
+  }
+}
+
+void dumpMethodOrData(int level, Entry * ep)
+{
+  lprintf(level, "eptype = 0x%08X\n", somtEntry(ep,u.m.eptype));
+  if (somtEntry(ep, u.m.eptype)) DumpEp(level+1, somtEntry(ep,u.m.eptype));
+  lprintf(level, "ptrs = %s\n", somtEntry(ep,u.m.ptrs));
+  lprintf(level, "array = 0x%08X\n", somtEntry(ep,u.m.array));//_NumberList
+  lprintf(level, "arrays = %s\n", somtEntry(ep,u.m.arrays));
+  lprintf(level, "defn = %s\n", somtEntry(ep,u.m.defn));
+  lprintf(level, "type = %s\n", somtEntry(ep,u.m.type));
+  lprintf(level, "varargs = %s\n", somtEntry(ep,u.m.varargs) ? "true" : "false");
+  lprintf(level, "private = %s\n", somtEntry(ep,u.m.isprivate) ? "true" : "false");
+  lprintf(level, "inout = %d\n", somtEntry(ep,u.m.inoutmode));
+  lprintf(level, "selfref = %s\n", somtEntry(ep,u.m.isselfref) ? "true" : "false");
+  lprintf(level, "oneway = %s\n", somtEntry(ep,u.m.isoneway) ? "true" : "false");
+  lprintf(level, "argcnt = %d\n", somtEntry(ep,u.m.argcnt));
+  lprintf(level, "args = 0x%08X\n", somtEntry(ep,u.m.args));
+  if (somtEntry(ep,u.m.args)) DumpEp(level+1, somtEntry(ep,u.m.args));
+  lprintf(level, "omethod = 0x%08X\n", somtEntry(ep,u.m.omethod));
+  if (somtEntry(ep,u.m.omethod)) DumpEp(level+1, somtEntry(ep,u.m.omethod));
+  lprintf(level, "oparent = 0x%08X\n", somtEntry(ep,u.m.oparent));
+  if (somtEntry(ep,u.m.oparent)) DumpEp(level, somtEntry(ep,u.m.oparent));
+  lprintf(level, "group = 0x%08X\n", somtEntry(ep,u.m.group));
+  if (somtEntry(ep,u.m.group)) DumpEp(level+1, somtEntry(ep,u.m.group));
+  lprintf(level, "next = 0x%08X\n", somtEntry(ep,u.m.next));
+  if (somtEntry(ep,u.m.next)) DumpEp(level+1, somtEntry(ep,u.m.next));
+  lprintf(level, "ctxsa = 0x%08X\n", somtEntry(ep,u.m.ctxsa));//CORBA_char **
+  lprintf(level, "raiseslist = 0x%08X\n", somtEntry(ep,u.m.raiseslist));//_Mlist
+}
