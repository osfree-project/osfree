+/*
+
+  Messages related functions.
+
+*/
+
+#define global
+#include <emitlib.h>
+
+#include <assert.h>
+
+char errormsg[]="(Message could not be retrieved from message catalog.)\n";
+
+void va_somtmsg(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, va_list args)
+{
+	assert(fmt);
+	if (file&&lineno&&strlen(file)) printf("(%s: %d) ", file, lineno);
+	vprintf(fmt, args);
+}
+
+void va_somtfatal(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, va_list args)
+{
+	assert(fmt);
+	printf("Fatal error: ");
+	va_somtmsg(file, lineno, fmt, args);
+	SMPOSTERROR(FATAL);
+}
+
+void va_somtwarn(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, va_list args)
+{
+	assert(fmt);
+	printf("warning: ");
+	va_somtmsg(file, lineno, fmt, args);
+	SMPOSTERROR(WARN);
+}
+
+void va_somterror(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, va_list args)
+{
+	assert(fmt);
+	printf("error: ");
+	va_somtmsg(file, lineno, fmt, args);
+	SMPOSTERROR(_ERROR);
+}
+
+void va_somtinternal(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, va_list args)
+{
+	assert(fmt);
+	printf("internal error: ", file, lineno);
+	va_somtmsg(file, lineno, fmt, args);
+	SMPOSTERROR(INTERNAL);
+}
+
+SOMEXTERN void SOMLINK somtmsgSL(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, ...)
+{
+	va_list args;
+	assert(fmt);
+	va_start(args, fmt);
+	va_somtmsg(file, lineno, fmt, args);
+	va_end( args );
+}
+
+SOMEXTERN void SOMLINK somtwarnSL(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, ...)
+{
+	va_list args;
+	assert(fmt);
+	va_start(args, fmt);
+	va_somtwarn(file, lineno, fmt, args);
+	va_end( args );
+}
+
+
+SOMEXTERN void SOMLINK somterrorSL(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, ...)
+{
+	va_list args;
+	assert(fmt);
+	va_start(args, fmt);
+	va_somterror(file, lineno, fmt, args);
+	va_end( args );
+}
+
+SOMEXTERN void SOMLINK somtfatalSL(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, ...)
+{
+	va_list args;
+	assert(fmt);
+	va_start(args, fmt);
+	va_somtfatal(file, lineno, fmt, args);
+	va_end(args);
+	exit(0);
+}
+
+SOMEXTERN void SOMLINK somtinternalSL(CORBA_char *file, CORBA_long lineno, CORBA_char *fmt, ...)
+{
+	va_list args;
+	assert(fmt);
+	va_start(args, fmt);
+	va_somtinternal(file, lineno, fmt, args);
+	va_end( args );
+}
