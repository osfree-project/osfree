+	somtmsgSL(NULL, 0, "useshort: %s\n", somtGlobalFlag(useshort) ? "true" : "false");
+	dumpAttrs(0, "pragmas", somtGlobalFlag(pragmas));
+	dumpMlist(0, "glbemits", somtGlobalFlag(glbemits));
+	somtmsgSL(NULL, 0, "fullyqualified: %s\n", somtGlobalFlag(fullyqualified) ? "true" : "false");
+	somtmsgSL(NULL, 0, "tcdone: %s\n", somtGlobalFlag(tcdone) ? "true" : "false");
+	somtmsgSL(NULL, 0, "relchk: %s\n", somtGlobalFlag(relchk) ? "true" : "false");
+	somtmsgSL(NULL, 0, "binary: %s\n", somtGlobalFlag(binary) ? "true" : "false");
+}
+
+void DumpStab(Stab *stab)
+{
+	Sep * sep;
+	int i;
+	int level=dbg_level;
+
+	lprintf(level, "stab at 0x%08X\n", stab);
+	lprintf(level, "stab->size is %d\n", stab->size);
+	lprintf(level, "stab->entrysize is %d\n", stab->entrysize);
+	lprintf(level, "stab->nelms is %d\n", stab->nelms);
+	lprintf(level, "stab->base at 0x%08X\n", stab->base);
+	lprintf(level, "stab->limit at 0x%08X\n", stab->limit);
+	lprintf(level, "stab->buf at 0x%08X\n", stab->buf);
+	lprintf(level, "stab->ignorecase is %d\n", stab->ignorecase);
+	lprintf(level, "membuf at 0x%08X\n", stab->membuf);
+	for(i=0;i<stab->size;i++)
+	{
+		sep=&stab->buf[i];
+		if (sep->ep)
+		{
+			while(sep->ep)
+			{
+				lprintf(level, "stab slot %d = (0x%08X)%s\n", i, sep->ep->name, sep->ep->name);
+				sep=sep->next;
+			}
+		}
+	}
+}
+
+void DumpMemBuf(int level, CORBA_char * name, MemBuf *membuf)
+{
+	lprintf(level, "%s Membuf at 0x%08X\n", name, membuf);
+	lprintf(level, "%s base at 0x%08X\n", name, membuf->base);
+	lprintf(level, "%s size is %d\n", name, membuf->size);
+	lprintf(level, "%s nelms is %d\n", name, membuf->nelms);
+	lprintf(level, "%s cur at 0x%08X\n", name, membuf->cur);
+	lprintf(level, "%s stab at 0x%08X\n", name, membuf->stab);
+	if (membuf->stab) DumpStab(membuf->stab);
+}
