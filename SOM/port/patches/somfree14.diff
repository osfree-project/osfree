+SOMEXTERN void SOMLINK somtaddGAttSL(MemBuf **membuf, AttList **ap, CORBA_char *buf)
+{
+	AttList *i;
+	AttList *ap2;
+	CORBA_boolean found;
+	CORBA_char *value;
+
+	SOMCFunctionStart("membuf=0x%08X ap=0x%08X buf=(0x%08X)\"%s\"", membuf, ap, buf, buf);
+
+	value = strchr(buf, '=');
+	found = FALSE;
+	if ( !*membuf )
+	{
+		somtcreateMemBufSL(membuf, 1024, 0);
+		somtallocBufSL(*membuf, buf, 1);
+	}
+	if ( value )
+		*value++ = 0;
+
+	if ( somtGlobalFlag(verbose) )
+	{
+		printf("Modifier: \"%s\" = \"%s\".\n", buf, value?value:"");
+	}
+
+	if ( *ap )
+	{
+		for ( i = *ap; i; i = i->next )
+		{
+			if ( i->name && !strcmp(buf, i->name) )
+			{
+				found = TRUE;
+				if ( value )
+				{
+					i->value = somtallocBufSL(*membuf, value, strlen(value) + 1);
+				}
+				else
+				{
+					i->value = "";
+				}
+				break;
+			}
+		}
+
+		if ( !found )
+		{
+			ap2 = somtattallocSL(*membuf, buf, value);
+			somtattjoinSL(*ap, ap2);
+		}	
+	}
+	else
+	{
+		*ap = somtattallocSL(*membuf, buf, value);
+	}
+	SOMCFunctionEnd("");
+}
