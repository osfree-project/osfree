+SOMEXTERN int SOMLINK somtattjoinSL(register AttList *ap1, AttList *ap2)
+{
+  CORBA_boolean found;
+
+  SOMCDebug("%s", __FUNCTION__);
+
+  found = FALSE;
+  while ( !found && ap1->next )
+  {
+    if ( !strcmp(ap1->name, ap2->name) )
+      found = TRUE;
+    else
+      ap1 = ap1->next;
+  }
+  if ( !strcmp(ap1->name, ap2->name) )
+    found = TRUE;
+  if ( !found )
+    ap1->next = ap2;
+
+dumpAttrs(0, "", ap1);
+dumpAttrs(0, "", ap2);
+  if ( found )
+    return -1;
+  else
+    return 0;
+
+}
