+SOMEXTERN AttList * SOMLINK somtattallocSL(MemBuf *membuf, CORBA_char *name, CORBA_char *value)
+{
+	AttList *result;
+
+	SOMCFunctionStart("membuf=0x%08X, name=(0x%08X)\"%s\" value=(0x%08X)\"%s\"", membuf, name, name, value, value);
+
+	result = (AttList *)smcallocSL(sizeof(AttList));
+
+	if (somtg_f.idl == 0 && name && *name == 'c')
+	{
+		if (!strcmp(name, "classmethod") || !strcmp(name, "classdata" ))
+		{
+			name = "class";
+			SOMCDebug("WTF?");
+		}
+	}
+
+	if (name) result->name = membuf->stab?somtuniqStringSL(membuf, name):somtallocBufSL(membuf, name, strlen(name) + 1);
+	if (value) result->value = membuf->stab?somtuniqStringSL(membuf, value):somtallocBufSL(membuf, value, strlen(value) + 1);
+
+	DumpMemBuf(dbg_level+11, __FUNCTION__, membuf);
+	dumpAttrs(dbg_level+11, __FUNCTION__, result);
+
+	SOMCFunctionEnd("result=0x%08X", result);
+	return result;
+}
