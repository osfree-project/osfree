+{
+	CORBA_char dst[FILENAME_MAX];
+	CORBA_char buf[FILENAME_MAX];
+	CORBA_char *result;
+
+	SOMCFunctionStart("s=(0x%08X)\"%s\"", s, s);
+
+	result = findattSL(somtGlobalFlag(atts), s, NULL);
+
+	if ( !result )
+	{
+		strcpy(dst, "SM");
+		strcat(dst, somtuppercaseSL(s, buf));
+		result = getenv(dst);
+		if ( result )
+		{
+			strcpy(dst, s);
+			if ( *result )
+			{
+				strcat(dst, "=");
+				strcat(dst, result);
+			}
+			somtaddGAttSL(&somtg_membuf, somtGlobalFlagPtr(atts), dst);
+			result = findattSL(somtGlobalFlag(atts), s, NULL);
+		}
+		else
+		{
+			result = findattSL(somtGlobalFlag(pragmas), s, NULL);
+		}
+	}
+	SOMCFunctionEnd("result=(0x%08X)\"%s\"", result, result);
+	return result;  
