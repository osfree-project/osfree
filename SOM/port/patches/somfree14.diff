+void * OPTLINK mymalloc(size_t size);
+void * __cdecl mymallocSL(size_t size);
+void OPTLINK myfree(void *memblock);
+void * OPTLINK mycalloc(size_t nmemb, size_t size);
+void * OPTLINK myrealloc(void *bp, size_t nbytes);
+
+// Use IBM SOM 3.0 ABI for non SOMLINK functions (1) or IBM SOM 2.1 ABI (0)
+//SOMEXTERN int somtSOM30ABI;
+
+// Used in sommplan.dll
+global void * (OPTLINK *somtrealloc)(void *bp, size_t nbytes);
+
+// Used by somFree somopc.exe
+global void * (OPTLINK *somtfree)(void *bp);
+
+SOMEXTERN void * SOMLINK somtsmallocSL(size_t nbytes, BOOL clear)
+{
+  void * result=NULL;
+  SOMCFunctionStart("nbytes=%ld clear=%d", nbytes, clear);
+  if (nbytes)
+  {
+	result=malloc(nbytes);
+	if (!result) somtmrifatalSL(NULL, 0, SOMT_CANT_ALLOC2, nbytes);
+	if (clear) memset(result, 0, nbytes);
+  }
+  SOMCFunctionEnd("result=0x%08X", result);
+  return result;
+}
+
+// This is first called function from sc.exe, so we detect here
+// is it SOM 2.1 compiler or SOM 3.0 compiler (for NT only)
+BOOL somtAPIFirstCall=1;
+SOMEXTERN void * OPTLINK somtsmalloc(size_t nbytes, BYTE clear)
+{
+	size_t n;
+	void * result;
+
+	__asm {mov n, eax};
+
+	if (somtAPIFirstCall)
+	{
+        // Check is a 256 bytes to allocate in stack or in eax.
+		// For IBM SOM 2.1 NT both n and nbytes will be 256
+		if ((n==nbytes) && (n==256))
+		{
+			somtSOM30ABI=0;
+		} else {
+			somtSOM30ABI=1;
+		}
+	}
+
+	if (somtSOM30ABI) OPTLINK_2ARGS_DWORD_BYTE(nbytes, clear);
+	if (somtAPIFirstCall)
+	{
+		SOMCDebug("SC ABI %s", somtSOM30ABI?"3.0":"2.1");
+		somtAPIFirstCall=0;
+	}
+	
+	SOMCFunctionStart("nbytes=%ld clear=%d", nbytes, clear);
+	result=somtsmallocSL(nbytes, clear);
+	SOMCFunctionEnd("result=0x%08X", result);
+	return result;
+}
+
+
+// This is first called function with arguments from somipc.exe,
+// so we detect here is it SOM 2.1 pre-compiler or SOM 3.0 pre-compiler (for NT only)
+void OPTLINK somtinitMalloc(BOOL a)
+{
+	BOOL n;
+	__asm {mov n, eax};
+
+	if (somtAPIFirstCall)
+	{
+        // Check is 'a' arg is zero in stack or in eax.
+		// For IBM SOM 2.1 NT both n and a will be 0
+		if ((n==a) && (n==0))
+		{
+			somtSOM30ABI=0;
+		} else {
+			somtSOM30ABI=1;
+		}
+	}
+
+	OPTLINK_ARGS(a);
+	
+	SOMCFunctionStart("a=%d", a);
+	if (somtAPIFirstCall)
+	{
+		SOMCDebug("SOMIPC ABI %s", somtSOM30ABI?"3.0":"2.1");
+		somtAPIFirstCall=0;
+	}
+	SOMCFunctionEnd("");
+}
+
+SOMEXTERN void SOMLINK somtsmfreeSL(void *first, ...)
+{
+  SOMCDebug("%s not implemented", __FUNCTION__);
+}
+
+SOMEXTERN void  OPTLINK somtsmfree(void *first, ...)
+{
+  SOMCDebug("%s not implemented", __FUNCTION__);
+  SOMCDebug(__FUNCTION__);
+}
