+SOMEXTERN CORBA_char * SOMLINK somtsearchFileSL(CORBA_char *file, CORBA_char *fullpath, CORBA_char *env)
+{
+  CORBA_char *path;
+
+	SOMCDebug("%s file=%s fullpath=%s anv=%s", __FUNCTION__, file, fullpath, env);
+
+  if (!file) return NULL;
+  if (!file[0]) return NULL;
+
+  if (somtfexistsSL(file))
+  {
+    return strcpy(fullpath, file);
+  }
+  else
+  {
+    if (file[0]=='/') return NULL;
+#if defined(_WIN32) || defined(__OS2__) || defined(__DOS__)
+    if (file[0]==SMSLASH) return NULL;
+    if (file[1]==':') return NULL;
+#endif
+
+    path=getenv(env);
+
+#if !defined(_WIN32) && !defined(__OS2__) && !defined(__DOS__)
+    if (!path) path="/bin:/usr/bin:";
+#endif
+
+    if (path)
+    {
+      while (*path)
+      {
+        CORBA_char buf[1024];
+        CORBA_char *q;
+
+        q=buf;
+
+        while ((*path)&&(*path !=SMDELIMITER))
+        {
+          *q=*path;
+          path++;
+          q++;
+        }
+        *q=0;
+        if (*path) path++;
+
+        if (!buf[0])
+        {
+          _getcwd(buf,sizeof(buf));
+        }
+
+        if (buf[0])
+        {
+          if (!strcmp(buf,"."))
+          {
+            _getcwd(buf,sizeof(buf));
+          }
+          snprintf(buf, sizeof(buf)-1, "%s%c", buf, SMSLASH);
+          strncat(buf,file,sizeof(buf)-1);
+
+          if (somtfexistsSL(buf))
+          {
+            return strcpy(fullpath,buf);
+          }
+        }
+      }
+    }
+    return NULL;
+  }
+}
