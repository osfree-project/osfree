+SOMEXTERN void OPTLINK somtaddGAtt(MemBuf **membuf, AttList **ap, CORBA_char *buf)
+{
+	OPTLINK_ARGS(membuf, ap, buf);
+	SOMCFunctionStart("membuf=0x%08X ap=0x%08X buf=(0x%08X)\"%s\"", membuf, ap, buf, buf);
+	somtaddGAttSL(membuf, ap, buf);
+	SOMCFunctionEnd("");
+}
+
